LLM_BASE_URL=https://openrouter.ai/api/v1   # any OpenAI-compatible endpoint
LLM_API_KEY=
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free  # default free candidate; measured winner set via npm run models / eval
LLM_MAX_RPM=15
LLM_FALLBACK_BASE_URL=    # optional, may be another provider
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
TAVILY_API_KEY=
SEARCH_CACHE=off          # off | record | replay
PORT=3000
DATA_DIR=./data
NOW_OVERRIDE=             # ISO timestamp; tests and evals only
