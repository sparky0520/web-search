LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   # Google Gemini or OpenRouter endpoint
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash                # fast, free tier, excellent tool calling
LLM_MAX_RPM=15
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1    # optional fallback provider
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
TAVILY_API_KEY=
SEARCH_CACHE=off          # off | record | replay
PORT=3000
DATA_DIR=./data
NOW_OVERRIDE=             # ISO timestamp; tests and evals only
