{
  "name": "web-search-agent",
  "version": "1.0.0",
  "description": "Fast, resilient web-search chat agent for the minimi challenge",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx evals/run.ts",
    "models": "tsx scripts/models.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "chrono-node": "^2.7.7",
    "dompurify": "^3.2.4",
    "hono": "^4.7.2",
    "luxon": "^3.5.0",
    "marked": "^15.0.7",
    "openai": "^4.86.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
